<?xml version="1.0" encoding="utf-8"?>
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!-- Ref: https://developer.android.com/training/articles/security-config.html -->
    <!-- By default, do not allow clearText traffic -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates
                src="user"
                tools:ignore="AcceptsUserCertificates" />
        </trust-anchors>
    </base-config>

    <!-- Certificate pinning for production API domains -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">matrix.org</domain>
        <pin-set expiration="2027-06-01">
            <!-- Primary pin for matrix.org -->
            <pin digest="SHA-256">PRIMARY_SPKI_SHA256_FINGERPRINT=</pin>
            <!-- Backup pin for matrix.org -->
            <pin digest="SHA-256">BACKUP_SPKI_SHA256_FINGERPRINT=</pin>
        </pin-set>
    </domain-config>

    <!-- Certificate pinning for Element infrastructure -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">element.io</domain>
        <pin-set expiration="2027-06-01">
            <!-- Primary pin for element.io -->
            <pin digest="SHA-256">PRIMARY_SPKI_SHA256_FINGERPRINT=</pin>
            <!-- Backup pin for element.io -->
            <pin digest="SHA-256">BACKUP_SPKI_SHA256_FINGERPRINT=</pin>
        </pin-set>
    </domain-config>
</network-security-config>
